<Window x:Class="DogClubApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Клуб собаководов" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundLight}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="{StaticResource PrimaryDark}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Клуб собаководов" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="40" VerticalAlignment="Center">
            <TextBlock Text="Логин:" Foreground="{StaticResource TextDark}" FontWeight="Bold"/>
            <TextBox x:Name="TbLogin"/>

            <TextBlock Text="Пароль:" Foreground="{StaticResource TextDark}" FontWeight="Bold"/>
            <PasswordBox x:Name="PbPassword" Height="30" Margin="0,5,0,20" FontSize="14" Padding="5"/>

            <Button Content="Войти" Click="BtnLogin_Click" Style="{StaticResource MenuButtonStyle}" Height="40"/>
            <Button Content="Регистрация" Click="BtnRegister_Click" Style="{StaticResource MenuButtonStyle}" Background="#3498DB" Height="40"/>
        </StackPanel>
    </Grid>
</Window>