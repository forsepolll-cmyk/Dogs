<Window x:Class="DogClubApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ИС «Клуб собаководов»" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundLight}"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryDark}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Клуб собаководов" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="TbUserInfo" Text="Пользователь" Foreground="White" 
                           FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,120,0"/>
                <Button Content="Выйти" HorizontalAlignment="Right" Width="100" Height="30" 
                        Margin="0,0,20,0" Click="BtnLogout_Click" Background="{StaticResource DangerRed}" 
                        BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#34495E">
                <StackPanel Margin="10">
                    <Button x:Name="BtnMenuSobaki" Content="Собаки" Tag="0" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuVladelcy" Content="Владельцы" Tag="1" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuPorody" Content="Породы" Tag="2" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuVystavki" Content="Выставки" Tag="3" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuUchastniki" Content="Участники" Tag="4" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuUsers" Content="Пользователи" Tag="5" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuReports" Content="Отчеты" Tag="6" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMenuMyDogs" Content="Мои собаки" Tag="7" Click="Menu_Click" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </Border>

            <TabControl x:Name="MainTabControl" Grid.Column="1" Margin="10" Background="White" BorderThickness="0">

                <TabItem Header="Собаки" x:Name="TabSobaki">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="PanelAddSobaka" Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <Button Content="Добавить" Click="AddSobaka_Click" Style="{StaticResource MenuButtonStyle}" Width="120" Height="35" Background="{StaticResource PrimaryAccent}"/>
                            <Button Content="Удалить" Click="DeleteSobaka_Click" Style="{StaticResource MenuButtonStyle}" Width="120" Height="35" Background="{StaticResource DangerRed}"/>
                        </StackPanel>
                        <DataGrid x:Name="GridSobaki" Grid.Row="1"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Владельцы" x:Name="TabVladelcy">
                    <Grid>
                        <DataGrid x:Name="GridVladelcy"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Породы" x:Name="TabPorody">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="PanelAddPoroda" Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="TbPorodaName" Width="150" Margin="5"/>
                            <TextBlock Text="Описание:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="TbPorodaDesc" Width="250" Margin="5"/>
                            <Button Content="Добавить" Click="AddPoroda_Click" Style="{StaticResource MenuButtonStyle}" Width="100" Height="30" Background="{StaticResource PrimaryAccent}"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelDeletePoroda" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <Button Content="Удалить" Click="DeletePoroda_Click" Style="{StaticResource MenuButtonStyle}" Width="100" Height="30" Background="{StaticResource DangerRed}"/>
                        </StackPanel>
                        <DataGrid x:Name="GridPorody" Grid.Row="1"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Выставки" x:Name="TabVystavki">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="PanelAddVystavka" Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="TbVystName" Width="150" Margin="5"/>
                            <TextBlock Text="Дата (ГГГГ-ММ-ДД):" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="TbVystDate" Width="100" Margin="5"/>
                            <TextBlock Text="Место:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="TbVystPlace" Width="150" Margin="5"/>
                            <Button Content="Создать" Click="AddVystavka_Click" Style="{StaticResource MenuButtonStyle}" Width="100" Height="30" Background="{StaticResource PrimaryAccent}"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelDeleteVystavka" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <Button Content="Удалить" Click="DeleteVystavka_Click" Style="{StaticResource MenuButtonStyle}" Width="100" Height="30" Background="{StaticResource DangerRed}"/>
                        </StackPanel>
                        <DataGrid x:Name="GridVystavki" Grid.Row="1"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Участники" x:Name="TabUchastniki">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <Button x:Name="BtnRegisterToShow" Content="Записаться на выставку" Click="RegisterToShow_Click" Style="{StaticResource MenuButtonStyle}" Width="200" Height="35" Background="{StaticResource PrimaryAccent}"/>
                            <Button x:Name="BtnDeleteUchastnik" Content="Удалить" Click="DeleteUchastnik_Click" Style="{StaticResource MenuButtonStyle}" Width="120" Height="35" Background="{StaticResource DangerRed}"/>
                        </StackPanel>
                        <DataGrid x:Name="GridUchastniki" Grid.Row="1"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Пользователи" x:Name="TabUsers">
                    <DataGrid x:Name="GridUsers"/>
                </TabItem>

                <TabItem Header="Отчеты" x:Name="TabReports">
                    <StackPanel Margin="20">
                        <TextBlock Text="Формирование отчетов" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="Выберите выставку для отчета:" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CbReportVystavka" Width="300" Height="30" Margin="0,0,0,10"/>
                        <Button Content="Сформировать" Click="GenerateReport_Click" Style="{StaticResource MenuButtonStyle}" Width="200" Height="40" Background="{StaticResource PrimaryAccent}"/>
                        <DataGrid x:Name="GridReport" Margin="0,20,0,0" Height="300"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Мои собаки" x:Name="TabMyDogs">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ваши собаки (по вашему логину)" FontSize="16" Margin="20,10,0,10"/>
                        <DataGrid x:Name="GridMyDogs" Grid.Row="1"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>