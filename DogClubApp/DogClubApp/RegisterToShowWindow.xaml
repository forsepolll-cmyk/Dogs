<Window x:Class="DogClubApp.RegisterToShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись на выставку" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundLight}">
    <StackPanel Margin="20">
        <TextBlock Text="Выберите собаку:" FontWeight="Bold"/>
        <ComboBox x:Name="CbDog" Height="30" Margin="0,5,0,10"/>

        <TextBlock Text="Выберите выставку:" FontWeight="Bold"/>
        <ComboBox x:Name="CbShow" Height="30" Margin="0,5,0,10"/>

        <Button Content="Записаться" Click="BtnRegister_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,20,0,0"/>
    </StackPanel>
</Window>