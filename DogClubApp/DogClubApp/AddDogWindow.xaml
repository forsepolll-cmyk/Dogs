<Window x:Class="DogClubApp.AddDogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление собаки" Height="570" Width="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundLight}">
    <StackPanel Margin="20">
        <TextBlock Text="Кличка:" FontWeight="Bold"/>
        <TextBox x:Name="TbKlichka"/>

        <TextBlock Text="Порода:" FontWeight="Bold"/>
        <ComboBox x:Name="CbPoroda" Height="30" Margin="0,5,0,10"/>

        <TextBlock Text="Владелец:" FontWeight="Bold"/>
        <ComboBox x:Name="CbVladelec" Height="30" Margin="0,5,0,10"/>

        <TextBlock Text="Дата рождения (ГГГГ-ММ-ДД):" FontWeight="Bold"/>
        <TextBox x:Name="TbDate"/>

        <ComboBox x:Name="CbPol" Height="30" Margin="0,5,0,10">
            <ComboBoxItem Content="Мужской"/>
            <ComboBoxItem Content="Женский"/>
        </ComboBox>

        <TextBlock Text="Номер родословной:" FontWeight="Bold"/>
        <TextBox x:Name="TbRod"/>

        <TextBlock Text="Окрас:" FontWeight="Bold"/>
        <TextBox x:Name="TbOkras"/>

        <Button Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,20,0,0"/>
    </StackPanel>
</Window>