<Window x:Class="DogClubApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация владельца" Height="550" Width="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundLight}"
        ResizeMode="NoResize">
    <StackPanel Margin="25">
        <TextBlock Text="Регистрация нового владельца" FontSize="20" FontWeight="Bold" 
                   Foreground="{StaticResource PrimaryDark}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="ФИО:" FontWeight="Bold"/>
        <TextBox x:Name="TbFio"/>

        <TextBlock Text="Телефон:" FontWeight="Bold"/>
        <TextBox x:Name="TbPhone"/>

        <TextBlock Text="Email:" FontWeight="Bold"/>
        <TextBox x:Name="TbEmail"/>

        <TextBlock Text="Логин:" FontWeight="Bold"/>
        <TextBox x:Name="TbLogin"/>

        <TextBlock Text="Пароль:" FontWeight="Bold"/>
        <PasswordBox x:Name="PbPassword" Height="30" Margin="0,5,0,10" Padding="5"/>

        <Button Content="Зарегистрироваться" Click="BtnRegister_Click" 
                Style="{StaticResource MenuButtonStyle}" Height="40" Margin="0,10,0,0"/>
        <Button Content="Назад" Click="BtnBack_Click" 
                Style="{StaticResource MenuButtonStyle}" Height="40" Background="#7F8C8D"/>
    </StackPanel>
</Window>